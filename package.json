{
  "name": "jarvis",
  "productName": "Jarvis",
  "version": "0.1.0",
  "description": "Jarvis - local-first desktop AI agent",
  "author": "eScan Systems <contact@escan-systems.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "frontend/dist-electron/main.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "shortcut": "node scripts/create-shortcut.mjs",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "node scripts/build-frontend.mjs",
    "build:backend": "node scripts/build-backend.mjs",
    "package:win": "npm run build && electron-builder --win nsis --config installer/electron-builder.yml",
    "package:msi": "npm run build && electron-builder --win msi --config installer/electron-builder.yml",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "vitest run --config frontend/vitest.config.mts",
    "test:backend": "node scripts/run-python.mjs -m pytest tests/backend -q",
    "test:e2e": "npm run build:frontend && playwright test --config tests/e2e/playwright.config.ts",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
